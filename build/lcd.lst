 191:Core/Src/lcd.c **** * Function Name  : LCD_ClearLine
 192:Core/Src/lcd.c **** * Description    : Clears the selected line.
 193:Core/Src/lcd.c **** * Input          : - Line: the Line to be cleared.
 194:Core/Src/lcd.c **** *                    This parameter can be one of the following values:
 195:Core/Src/lcd.c **** *                       - Linex: where x can be 0..9
 196:Core/Src/lcd.c **** * Output         : None
 197:Core/Src/lcd.c **** * Return         : None
 198:Core/Src/lcd.c **** *******************************************************************************/
 199:Core/Src/lcd.c **** void LCD_ClearLine(u8 Line)
 200:Core/Src/lcd.c **** {
