 204:Core/Src/lcd.c **** * Function Name  : LCD_Clear
 205:Core/Src/lcd.c **** * Description    : Clears the hole LCD.
 206:Core/Src/lcd.c **** * Input          : Color: the color of the background.
 207:Core/Src/lcd.c **** * Output         : None
 208:Core/Src/lcd.c **** * Return         : None
 209:Core/Src/lcd.c **** *******************************************************************************/
 210:Core/Src/lcd.c **** void LCD_Clear(u16 Color)
 211:Core/Src/lcd.c **** {
 212:Core/Src/lcd.c **** 	u32 index = 0;
 213:Core/Src/lcd.c **** 	LCD_SetCursor(0x00, 0x0000); 
 214:Core/Src/lcd.c **** 	LCD_WriteRAM_Prepare(); /* Prepare to write GRAM */
 215:Core/Src/lcd.c **** 	for(index = 0; index < 76800; index++)
 216:Core/Src/lcd.c **** 	{
 217:Core/Src/lcd.c **** 		LCD_WriteRAM(Color);    
 218:Core/Src/lcd.c **** 	}
 219:Core/Src/lcd.c **** }
 220:Core/Src/lcd.c **** /*******************************************************************************
 221:Core/Src/lcd.c **** * Function Name  : LCD_SetCursor
 222:Core/Src/lcd.c **** * Description    : Sets the cursor position.
 223:Core/Src/lcd.c **** * Input          : - Xpos: specifies the X position.
 224:Core/Src/lcd.c **** *                  - Ypos: specifies the Y position. 
 225:Core/Src/lcd.c **** * Output         : None
 226:Core/Src/lcd.c **** * Return         : None
 227:Core/Src/lcd.c **** *******************************************************************************/
 228:Core/Src/lcd.c **** void LCD_SetCursor(u8 Xpos, u16 Ypos)
 229:Core/Src/lcd.c **** { 
 230:Core/Src/lcd.c **** 	LCD_WriteReg(R32, Xpos);
 231:Core/Src/lcd.c **** 	LCD_WriteReg(R33, Ypos);
 232:Core/Src/lcd.c **** }
 233:Core/Src/lcd.c **** /*******************************************************************************
 234:Core/Src/lcd.c **** * Function Name  : LCD_DrawChar
 235:Core/Src/lcd.c **** * Description    : Draws a character on LCD.
 236:Core/Src/lcd.c **** * Input          : - Xpos: the Line where to display the character shape.
 237:Core/Src/lcd.c **** *                    This parameter can be one of the following values:
 238:Core/Src/lcd.c **** *                       - Linex: where x can be 0..9
 239:Core/Src/lcd.c **** *                  - Ypos: start column address.
ARM GAS  C:\Users\86133\AppData\Local\Temp\ccDgQJpj.s 			page 8


 240:Core/Src/lcd.c **** *                  - c: pointer to the character data.
 241:Core/Src/lcd.c **** * Output         : None
 242:Core/Src/lcd.c **** * Return         : None
 243:Core/Src/lcd.c **** *******************************************************************************/
 244:Core/Src/lcd.c **** void LCD_DrawChar(u8 Xpos, u16 Ypos, uc16 *c)
 245:Core/Src/lcd.c **** {
 246:Core/Src/lcd.c **** 	u32 index = 0, i = 0;
 247:Core/Src/lcd.c **** 	u8 Xaddress = 0;
 248:Core/Src/lcd.c ****    
 249:Core/Src/lcd.c **** 	Xaddress = Xpos;
 250:Core/Src/lcd.c **** 	LCD_SetCursor(Xaddress, Ypos);
 251:Core/Src/lcd.c ****   
 252:Core/Src/lcd.c **** 	for(index = 0; index < 24; index++)
 253:Core/Src/lcd.c **** 	{
 254:Core/Src/lcd.c **** 		LCD_WriteRAM_Prepare(); /* Prepare to write GRAM */
 255:Core/Src/lcd.c **** 		for(i = 0; i < 16; i++)
 256:Core/Src/lcd.c **** 		{
 257:Core/Src/lcd.c **** 			if((c[index] & (1 << i)) == 0x00)
 258:Core/Src/lcd.c **** 			{
 259:Core/Src/lcd.c **** 				LCD_WriteRAM(BackColor);
 260:Core/Src/lcd.c **** 			}
 261:Core/Src/lcd.c **** 			else
 262:Core/Src/lcd.c **** 			{
 263:Core/Src/lcd.c **** 				LCD_WriteRAM(TextColor);
 264:Core/Src/lcd.c **** 			}
 265:Core/Src/lcd.c **** 		}
 266:Core/Src/lcd.c **** 		Xaddress++;
 267:Core/Src/lcd.c **** 		LCD_SetCursor(Xaddress, Ypos);
 268:Core/Src/lcd.c **** 	}
 269:Core/Src/lcd.c **** }
 270:Core/Src/lcd.c **** /*******************************************************************************
 271:Core/Src/lcd.c **** * Function Name  : LCD_DisplayChar
 272:Core/Src/lcd.c **** * Description    : Displays one character (16dots width, 24dots height).
 273:Core/Src/lcd.c **** * Input          : - Line: the Line where to display the character shape .
 274:Core/Src/lcd.c **** *                    This parameter can be one of the following values:
 275:Core/Src/lcd.c **** *                       - Linex: where x can be 0..9
 276:Core/Src/lcd.c **** *                  - Column: start column address.
 277:Core/Src/lcd.c **** *                  - Ascii: character ascii code, must be between 0x20 and 0x7E.
 278:Core/Src/lcd.c **** * Output         : None
 279:Core/Src/lcd.c **** * Return         : None
 280:Core/Src/lcd.c **** *******************************************************************************/
 281:Core/Src/lcd.c **** void LCD_DisplayChar(u8 Line, u16 Column, u8 Ascii)
 282:Core/Src/lcd.c **** {
 283:Core/Src/lcd.c **** 	Ascii -= 32;
 284:Core/Src/lcd.c **** 	LCD_DrawChar(Line, Column, &ASCII_Table[Ascii * 24]);
 285:Core/Src/lcd.c **** }
 286:Core/Src/lcd.c **** /*******************************************************************************
 287:Core/Src/lcd.c **** * Function Name  : LCD_DisplayStringLine
 288:Core/Src/lcd.c **** * Description    : Displays a maximum of 20 char on the LCD.
 289:Core/Src/lcd.c **** * Input          : - Line: the Line where to display the character shape .
 290:Core/Src/lcd.c **** *                    This parameter can be one of the following values:
 291:Core/Src/lcd.c **** *                       - Linex: where x can be 0..9
 292:Core/Src/lcd.c **** *                  - *ptr: pointer to string to display on LCD.
 293:Core/Src/lcd.c **** * Output         : None
 294:Core/Src/lcd.c **** * Return         : None
 295:Core/Src/lcd.c **** *******************************************************************************/
 296:Core/Src/lcd.c **** void LCD_DisplayStringLine(u8 Line, u8 *ptr)
ARM GAS  C:\Users\86133\AppData\Local\Temp\ccDgQJpj.s 			page 9


 297:Core/Src/lcd.c **** {
 298:Core/Src/lcd.c **** 	u32 i = 0;
 299:Core/Src/lcd.c **** 	u16 refcolumn = 319;//319;
 300:Core/Src/lcd.c **** 
 301:Core/Src/lcd.c **** 	while ((*ptr != 0) && (i < 20))	 //	20
 302:Core/Src/lcd.c **** 	{
 303:Core/Src/lcd.c **** 		LCD_DisplayChar(Line, refcolumn, *ptr);
 304:Core/Src/lcd.c **** 		refcolumn -= 16;
 305:Core/Src/lcd.c **** 		ptr++;
 306:Core/Src/lcd.c **** 		i++;
 307:Core/Src/lcd.c **** 	}
 308:Core/Src/lcd.c **** }
 309:Core/Src/lcd.c **** /*******************************************************************************
 310:Core/Src/lcd.c **** * Function Name  : LCD_SetDisplayWindow
 311:Core/Src/lcd.c **** * Description    : Sets a display window
 312:Core/Src/lcd.c **** * Input          : - Xpos: specifies the X buttom left position.
 313:Core/Src/lcd.c **** *                  - Ypos: specifies the Y buttom left position.
 314:Core/Src/lcd.c **** *                  - Height: display window height.
 315:Core/Src/lcd.c **** *                  - Width: display window width.
 316:Core/Src/lcd.c **** * Output         : None
 317:Core/Src/lcd.c **** * Return         : None
 318:Core/Src/lcd.c **** *******************************************************************************/
 319:Core/Src/lcd.c **** void LCD_SetDisplayWindow(u8 Xpos, u16 Ypos, u8 Height, u16 Width)
 320:Core/Src/lcd.c **** {
 321:Core/Src/lcd.c **** 	if(Xpos >= Height)
 322:Core/Src/lcd.c **** 	{
 323:Core/Src/lcd.c **** 		LCD_WriteReg(R80, (Xpos - Height + 1));
 324:Core/Src/lcd.c **** 	}
 325:Core/Src/lcd.c **** 	else
 326:Core/Src/lcd.c **** 	{
 327:Core/Src/lcd.c **** 		LCD_WriteReg(R80, 0);
 328:Core/Src/lcd.c **** 	}
 329:Core/Src/lcd.c **** 	LCD_WriteReg(R81, Xpos);
 330:Core/Src/lcd.c **** 	if(Ypos >= Width)
 331:Core/Src/lcd.c **** 	{
 332:Core/Src/lcd.c **** 		LCD_WriteReg(R82, (Ypos - Width + 1));
 333:Core/Src/lcd.c **** 	}  
 334:Core/Src/lcd.c **** 	else
 335:Core/Src/lcd.c **** 	{
 336:Core/Src/lcd.c **** 		LCD_WriteReg(R82, 0);
 337:Core/Src/lcd.c **** 	}
 338:Core/Src/lcd.c **** 	/* Vertical GRAM End Address */
 339:Core/Src/lcd.c **** 	LCD_WriteReg(R83, Ypos);
 340:Core/Src/lcd.c **** 	LCD_SetCursor(Xpos, Ypos);
 341:Core/Src/lcd.c **** }
 342:Core/Src/lcd.c **** /*******************************************************************************
 343:Core/Src/lcd.c **** * Function Name  : LCD_WindowModeDisable
 344:Core/Src/lcd.c **** * Description    : Disables LCD Window mode.
 345:Core/Src/lcd.c **** * Input          : None
 346:Core/Src/lcd.c **** * Output         : None
 347:Core/Src/lcd.c **** * Return         : None
 348:Core/Src/lcd.c **** *******************************************************************************/
 349:Core/Src/lcd.c **** void LCD_WindowModeDisable(void)
 350:Core/Src/lcd.c **** {
 351:Core/Src/lcd.c **** 	LCD_SetDisplayWindow(239, 0x13F, 240, 320);
 352:Core/Src/lcd.c **** 	LCD_WriteReg(R3, 0x1018);    
 353:Core/Src/lcd.c **** }
ARM GAS  C:\Users\86133\AppData\Local\Temp\ccDgQJpj.s 			page 10


 354:Core/Src/lcd.c **** /*******************************************************************************
 355:Core/Src/lcd.c **** * Function Name  : LCD_DrawLine
 356:Core/Src/lcd.c **** * Description    : Displays a line.
 357:Core/Src/lcd.c **** * Input          : - Xpos: specifies the X position.
 358:Core/Src/lcd.c **** *                  - Ypos: specifies the Y position.
 359:Core/Src/lcd.c **** *                  - Length: line length.
 360:Core/Src/lcd.c **** *                  - Direction: line direction.
 361:Core/Src/lcd.c **** *                    This parameter can be one of the following values: Vertical 
 362:Core/Src/lcd.c **** *                    or Horizontal.
 363:Core/Src/lcd.c **** * Output         : None
 364:Core/Src/lcd.c **** * Return         : None
 365:Core/Src/lcd.c **** *******************************************************************************/
 366:Core/Src/lcd.c **** void LCD_DrawLine(u8 Xpos, u16 Ypos, u16 Length, u8 Direction)
 367:Core/Src/lcd.c **** {
 368:Core/Src/lcd.c **** 	u32 i = 0;
 369:Core/Src/lcd.c ****   
 370:Core/Src/lcd.c **** 	LCD_SetCursor(Xpos, Ypos);
 371:Core/Src/lcd.c **** 	if(Direction == Horizontal)
 372:Core/Src/lcd.c **** 	{
 373:Core/Src/lcd.c **** 		LCD_WriteRAM_Prepare(); /* Prepare to write GRAM */
 374:Core/Src/lcd.c **** 		for(i = 0; i < Length; i++)
 375:Core/Src/lcd.c **** 		{
 376:Core/Src/lcd.c **** 			LCD_WriteRAM(TextColor);
 377:Core/Src/lcd.c **** 		}
 378:Core/Src/lcd.c **** 	}
 379:Core/Src/lcd.c **** 	else
 380:Core/Src/lcd.c **** 	{
 381:Core/Src/lcd.c **** 		for(i = 0; i < Length; i++)
 382:Core/Src/lcd.c **** 		{
 383:Core/Src/lcd.c **** 			LCD_WriteRAM_Prepare(); /* Prepare to write GRAM */
 384:Core/Src/lcd.c **** 			LCD_WriteRAM(TextColor);
 385:Core/Src/lcd.c **** 			Xpos++;
 386:Core/Src/lcd.c **** 			LCD_SetCursor(Xpos, Ypos);
 387:Core/Src/lcd.c **** 		}
 388:Core/Src/lcd.c **** 	}
 389:Core/Src/lcd.c **** }
 390:Core/Src/lcd.c **** /*******************************************************************************
 391:Core/Src/lcd.c **** * Function Name  : LCD_DrawRect
 392:Core/Src/lcd.c **** * Description    : Displays a rectangle.
 393:Core/Src/lcd.c **** * Input          : - Xpos: specifies the X position.
 394:Core/Src/lcd.c **** *                  - Ypos: specifies the Y position.
 395:Core/Src/lcd.c **** *                  - Height: display rectangle height.
 396:Core/Src/lcd.c **** *                  - Width: display rectangle width.
 397:Core/Src/lcd.c **** * Output         : None
 398:Core/Src/lcd.c **** * Return         : None
 399:Core/Src/lcd.c **** *******************************************************************************/
 400:Core/Src/lcd.c **** void LCD_DrawRect(u8 Xpos, u16 Ypos, u8 Height, u16 Width)
 401:Core/Src/lcd.c **** {
 402:Core/Src/lcd.c **** 	LCD_DrawLine(Xpos, Ypos, Width, Horizontal);
 403:Core/Src/lcd.c **** 	LCD_DrawLine((Xpos + Height), Ypos, Width, Horizontal);
 404:Core/Src/lcd.c ****   
 405:Core/Src/lcd.c **** 	LCD_DrawLine(Xpos, Ypos, Height, Vertical);
 406:Core/Src/lcd.c **** 	LCD_DrawLine(Xpos, (Ypos - Width + 1), Height, Vertical);
 407:Core/Src/lcd.c **** }
 408:Core/Src/lcd.c **** /*******************************************************************************
 409:Core/Src/lcd.c **** * Function Name  : LCD_DrawCircle
 410:Core/Src/lcd.c **** * Description    : Displays a circle.
ARM GAS  C:\Users\86133\AppData\Local\Temp\ccDgQJpj.s 			page 11


 411:Core/Src/lcd.c **** * Input          : - Xpos: specifies the X position.
 412:Core/Src/lcd.c **** *                  - Ypos: specifies the Y position.
 413:Core/Src/lcd.c **** *                  - Height: display rectangle height.
 414:Core/Src/lcd.c **** *                  - Width: display rectangle width.
 415:Core/Src/lcd.c **** * Output         : None
 416:Core/Src/lcd.c **** * Return         : None
 417:Core/Src/lcd.c **** *******************************************************************************/
 418:Core/Src/lcd.c **** void LCD_DrawCircle(u8 Xpos, u16 Ypos, u16 Radius)
 419:Core/Src/lcd.c **** {
 420:Core/Src/lcd.c **** 	s32  D;
 421:Core/Src/lcd.c **** 	u32  CurX;
 422:Core/Src/lcd.c **** 	u32  CurY;
 423:Core/Src/lcd.c ****   
 424:Core/Src/lcd.c ****   	D = 3 - (Radius << 1);
 425:Core/Src/lcd.c ****   	CurX = 0;
 426:Core/Src/lcd.c ****   	CurY = Radius;
 427:Core/Src/lcd.c ****   
 428:Core/Src/lcd.c ****   	while (CurX <= CurY)
 429:Core/Src/lcd.c ****   	{
 430:Core/Src/lcd.c **** 	    LCD_SetCursor(Xpos + CurX, Ypos + CurY);
 431:Core/Src/lcd.c **** 	    LCD_WriteRAM_Prepare(); /* Prepare to write GRAM */
 432:Core/Src/lcd.c **** 	    LCD_WriteRAM(TextColor);
 433:Core/Src/lcd.c **** 	
 434:Core/Src/lcd.c **** 	    LCD_SetCursor(Xpos + CurX, Ypos - CurY);
 435:Core/Src/lcd.c **** 	    LCD_WriteRAM_Prepare(); /* Prepare to write GRAM */
 436:Core/Src/lcd.c **** 	    LCD_WriteRAM(TextColor);
 437:Core/Src/lcd.c **** 	
 438:Core/Src/lcd.c **** 	    LCD_SetCursor(Xpos - CurX, Ypos + CurY);
 439:Core/Src/lcd.c **** 	    LCD_WriteRAM_Prepare(); /* Prepare to write GRAM */
 440:Core/Src/lcd.c **** 	    LCD_WriteRAM(TextColor);
 441:Core/Src/lcd.c **** 	
 442:Core/Src/lcd.c **** 	    LCD_SetCursor(Xpos - CurX, Ypos - CurY);
 443:Core/Src/lcd.c **** 	    LCD_WriteRAM_Prepare(); /* Prepare to write GRAM */
 444:Core/Src/lcd.c **** 	    LCD_WriteRAM(TextColor);
 445:Core/Src/lcd.c **** 	
 446:Core/Src/lcd.c **** 	    LCD_SetCursor(Xpos + CurY, Ypos + CurX);
 447:Core/Src/lcd.c **** 	    LCD_WriteRAM_Prepare(); /* Prepare to write GRAM */
 448:Core/Src/lcd.c **** 	    LCD_WriteRAM(TextColor);
 449:Core/Src/lcd.c **** 	
 450:Core/Src/lcd.c **** 	    LCD_SetCursor(Xpos + CurY, Ypos - CurX);
 451:Core/Src/lcd.c **** 	    LCD_WriteRAM_Prepare(); /* Prepare to write GRAM */
 452:Core/Src/lcd.c **** 	    LCD_WriteRAM(TextColor);
 453:Core/Src/lcd.c **** 	
 454:Core/Src/lcd.c **** 	    LCD_SetCursor(Xpos - CurY, Ypos + CurX);
 455:Core/Src/lcd.c **** 	    LCD_WriteRAM_Prepare(); /* Prepare to write GRAM */
 456:Core/Src/lcd.c **** 	    LCD_WriteRAM(TextColor);
 457:Core/Src/lcd.c **** 	
 458:Core/Src/lcd.c **** 	    LCD_SetCursor(Xpos - CurY, Ypos - CurX);
 459:Core/Src/lcd.c **** 	    LCD_WriteRAM_Prepare(); /* Prepare to write GRAM */
 460:Core/Src/lcd.c **** 	    LCD_WriteRAM(TextColor);
 461:Core/Src/lcd.c **** 
 462:Core/Src/lcd.c **** 	    if (D < 0)
 463:Core/Src/lcd.c **** 	    { 
 464:Core/Src/lcd.c **** 	      D += (CurX << 2) + 6;
 465:Core/Src/lcd.c **** 	    }
 466:Core/Src/lcd.c **** 	    else
 467:Core/Src/lcd.c **** 	    {
ARM GAS  C:\Users\86133\AppData\Local\Temp\ccDgQJpj.s 			page 12


 468:Core/Src/lcd.c **** 	      D += ((CurX - CurY) << 2) + 10;
 469:Core/Src/lcd.c **** 	      CurY--;
 470:Core/Src/lcd.c **** 	    }
 471:Core/Src/lcd.c **** 	    CurX++;
 472:Core/Src/lcd.c ****   	}
 473:Core/Src/lcd.c **** }
 474:Core/Src/lcd.c **** /*******************************************************************************
 475:Core/Src/lcd.c **** * Function Name  : LCD_DrawMonoPict
 476:Core/Src/lcd.c **** * Description    : Displays a monocolor picture.
 477:Core/Src/lcd.c **** * Input          : - Pict: pointer to the picture array.
 478:Core/Src/lcd.c **** * Output         : None
 479:Core/Src/lcd.c **** * Return         : None
 480:Core/Src/lcd.c **** *******************************************************************************/
 481:Core/Src/lcd.c **** void LCD_DrawMonoPict(uc32 *Pict)
 482:Core/Src/lcd.c **** {
 483:Core/Src/lcd.c **** 	u32 index = 0, i = 0;
 484:Core/Src/lcd.c **** 
 485:Core/Src/lcd.c **** 	LCD_SetCursor(0, 319); 
 486:Core/Src/lcd.c **** 
 487:Core/Src/lcd.c **** 	LCD_WriteRAM_Prepare(); /* Prepare to write GRAM */
 488:Core/Src/lcd.c **** 	for(index = 0; index < 2400; index++)
 489:Core/Src/lcd.c **** 	{
 490:Core/Src/lcd.c **** 		for(i = 0; i < 32; i++)
 491:Core/Src/lcd.c **** 		{
 492:Core/Src/lcd.c **** 			if((Pict[index] & (1 << i)) == 0x00)
 493:Core/Src/lcd.c **** 			{
 494:Core/Src/lcd.c **** 				LCD_WriteRAM(BackColor);
 495:Core/Src/lcd.c **** 			}
 496:Core/Src/lcd.c **** 			else
 497:Core/Src/lcd.c **** 			{
 498:Core/Src/lcd.c **** 				LCD_WriteRAM(TextColor);
 499:Core/Src/lcd.c **** 			}
 500:Core/Src/lcd.c **** 		}
 501:Core/Src/lcd.c **** 	}
 502:Core/Src/lcd.c **** }
 503:Core/Src/lcd.c **** /*******************************************************************************
 504:Core/Src/lcd.c **** * Function Name  : LCD_WriteBMP
 505:Core/Src/lcd.c **** * Description    : Displays a bitmap picture loaded in the internal Flash.
 506:Core/Src/lcd.c **** * Input          : - BmpAddress: Bmp picture address in the internal Flash.
 507:Core/Src/lcd.c **** * Output         : None
 508:Core/Src/lcd.c **** * Return         : None
 509:Core/Src/lcd.c **** *******************************************************************************/
 510:Core/Src/lcd.c **** void LCD_WriteBMP(u32 BmpAddress)
 511:Core/Src/lcd.c **** {
 512:Core/Src/lcd.c **** 	u32 index = 0, size = 0;
 513:Core/Src/lcd.c **** 
 514:Core/Src/lcd.c **** 	size = *(vu16 *) (BmpAddress + 2);
 515:Core/Src/lcd.c **** 	size |= (*(vu16 *) (BmpAddress + 4)) << 16;
 516:Core/Src/lcd.c **** 
 517:Core/Src/lcd.c **** 	index = *(vu16 *) (BmpAddress + 10);
 518:Core/Src/lcd.c **** 	index |= (*(vu16 *) (BmpAddress + 12)) << 16;
 519:Core/Src/lcd.c **** 	size = (size - index)/2;
 520:Core/Src/lcd.c **** 	BmpAddress += index;
 521:Core/Src/lcd.c **** 
 522:Core/Src/lcd.c **** 	LCD_WriteReg(R3, 0x1008);
 523:Core/Src/lcd.c **** 	LCD_WriteRAM_Prepare();
 524:Core/Src/lcd.c **** 	for(index = 0; index < size; index++)
ARM GAS  C:\Users\86133\AppData\Local\Temp\ccDgQJpj.s 			page 13


 525:Core/Src/lcd.c **** 	{
 526:Core/Src/lcd.c **** 		LCD_WriteRAM(*(vu16 *)BmpAddress);
 527:Core/Src/lcd.c **** 		BmpAddress += 2;
 528:Core/Src/lcd.c **** 	}
 529:Core/Src/lcd.c **** 	LCD_WriteReg(R3, 0x1018);
 530:Core/Src/lcd.c **** }
