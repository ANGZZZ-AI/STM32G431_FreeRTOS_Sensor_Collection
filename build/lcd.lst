 146:Core/Src/lcd.c **** * Function Name  : STM3210B_LCD_Init
 147:Core/Src/lcd.c **** * Description    : Initializes the LCD.
 148:Core/Src/lcd.c **** * Input          : None
 149:Core/Src/lcd.c **** * Output         : None
 150:Core/Src/lcd.c **** * Return         : None
 151:Core/Src/lcd.c **** *******************************************************************************/
 152:Core/Src/lcd.c **** void LCD_Init(void)
 153:Core/Src/lcd.c **** { 
 154:Core/Src/lcd.c **** 	LCD_CtrlLinesConfig();
 155:Core/Src/lcd.c **** 	dummy = LCD_ReadReg(0);	
 156:Core/Src/lcd.c **** 	
 157:Core/Src/lcd.c **** 	if(dummy == 0x8230){
 158:Core/Src/lcd.c **** 		REG_8230_Init();
 159:Core/Src/lcd.c **** 	}
 160:Core/Src/lcd.c **** 	else{
 161:Core/Src/lcd.c **** 		REG_932X_Init();	
 162:Core/Src/lcd.c **** 	}
 163:Core/Src/lcd.c **** 	dummy = LCD_ReadReg(0);	
 164:Core/Src/lcd.c **** 
 165:Core/Src/lcd.c **** }
